<div class="container d-flex flex-column align-items-center mt-5" style="min-height: 50vh;">
  <div class="w-100" style="max-width: 700px; margin-top: 10vh;">
    <h2 class="text-center mb-4">
      <i class="bi bi-search me-2"></i>Inhalte durchsuchen
    </h2>
    
    <%= form_with url: lecture_search_content_path(@lecture), method: :get, local: true, data: { turbo_frame: "main" } do |f| %>
      <div class="input-group input-group-lg shadow-sm">
        <%= f.text_field :search, class: "form-control", placeholder: "Suche in der Veranstaltung...", value: @query, autofocus: true %>
        <button class="btn btn-primary" type="submit">
          Suchen
        </button>
      </div>
    <% end %>

    <% if @query.present? %>
      <div class="mt-5">
        <h4 class="text-muted text-center mb-4">
          Ergebnisse für: <strong><%= @query %></strong>
        </h4>
        
        <% if @error.present? %>
          <div class="alert alert-danger mt-4 text-center">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <%= @error %>
          </div>
        <% elsif @results.blank? %>
          <div class="alert alert-secondary mt-4 text-center">
            <i class="bi bi-info-circle me-2"></i>
            Keine Ergebnisse gefunden.
          </div>
        <% else %>
          <div class="list-group shadow-sm">
            <% @results.each do |result| %>
              <% lesson = @lessons_by_id[result["lesson_rails_id"]] %>
              <div class="list-group-item list-group-item-action flex-column align-items-start p-4">
                <div class="d-flex w-100 justify-content-between mb-2">
                  <h5 class="mb-1 text-primary">
                    <i class="bi bi-play-circle me-2"></i>
                    <%= lesson ? lesson.title : "Unbekannte Lektion" %>
                  </h5>
                  <% if result["rrf_score"] %>
                    <small class="text-muted">Relevanz: <%= (result["rrf_score"] * 100).round(2) %>%</small>
                  <% end %>
                </div>
                <p class="mb-1 text-secondary" style="font-size: 0.95rem; line-height: 1.5;">
                  &bdquo;<%= result["text"] %>&ldquo;
                </p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
